{
  "folders": [
    {
      "path": "dlams-deployment"
    },
    {
      "path": "dlams-fastapi"
    },
    {
      "path": "dlams-ui"
    }
  ],
  "settings": {
    "python.defaultInterpreterPath": "./dlams-fastapi/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "files.associations": {
      "*.py": "python"
    },
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.flake8",
      "ms-python.black-formatter",
      "ms-vscode.vscode-typescript-next",
      "esbenp.prettier-vscode",
      "bradlc.vscode-tailwindcss"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Start FastAPI Server",
        "type": "shell",
        "command": "cd dlams-fastapi && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "new"
        },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Start UI Development Server",
        "type": "shell",
        "command": "cd dlams-ui && npm run dev",
        "group": "build",
        "presentation": {
          "echo": true,
          "reveal": "always",
          "focus": false,
          "panel": "new"
        },
        "isBackground": true,
        "problemMatcher": []
      },
      {
        "label": "Start Both Servers",
        "dependsOrder": "parallel",
        "dependsOn": ["Start FastAPI Server", "Start UI Development Server"],
        "group": {
          "kind": "build",
          "isDefault": true
        }
      }
    ]
  }
}
